# Server Configuration
PORT=5000
NODE_ENV=production

# Database
MONGODB_URI=mongodb://localhost:27017/elevare
# For production, use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/elevare?retryWrites=true&w=majority

# Authentication - CHANGE THIS IN PRODUCTION
JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_STRING_IN_PRODUCTION
JWT_EXPIRE=7d

# Admin credentials (auto-created on first startup)
ADMIN_EMAIL=admin@elevare.com
ADMIN_PASSWORD=Admin@1234

# AI Service
AI_SERVICE_URL=http://localhost:8000

# CORS
CORS_ORIGIN=http://localhost:3000
# For production, set to your frontend domain:
# CORS_ORIGIN=https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Memory DB (only for development/testing)
USE_MEMORY_DB=false

# Logging
LOG_LEVEL=info
